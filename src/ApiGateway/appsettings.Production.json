{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Warning"
        }
    },
    "Cors": {
        "AllowedOrigins": [
            "https://ithelpdesk-frontend.azurecontainerapps.io"
        ]
    },
    "ReverseProxy": {
        "Clusters": {
            "auth-cluster": {
                "Destinations": {
                    "auth-primary": {
                        "Address": "http://auth-service/"
                    }
                }
            },
            "ticket-cluster": {
                "Destinations": {
                    "ticket-primary": {
                        "Address": "http://ticket-service/"
                    }
                }
            },
            "assignment-cluster": {
                "Destinations": {
                    "assignment-primary": {
                        "Address": "http://assignment-service/"
                    }
                }
            },
            "sla-cluster": {
                "Destinations": {
                    "sla-primary": {
                        "Address": "http://sla-service/"
                    }
                }
            },
            "notification-cluster": {
                "Destinations": {
                    "notification-primary": {
                        "Address": "http://notification-service/"
                    }
                }
            }
        }
    }
}