      "targets": [
        {
          "expr": "100 * sum by (service) (rate(http_requests_received_total{code=~\"5..\"}[5m])) / sum by (service) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "5xx error rate",
      "type": "timeseries"
    }
