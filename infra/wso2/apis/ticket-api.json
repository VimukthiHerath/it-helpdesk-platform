{
    "openapi": "3.0.3",
    "info": {
        "title": "Ticket API",
        "description": "Core ticket creation, listing, and management service for IT Helpdesk Platform",
        "version": "1.0.0",
        "contact": {
            "name": "IT Helpdesk Team"
        }
    },
    "servers": [
        {
            "url": "http://localhost:5164",
            "description": "Local development"
        },
        {
            "url": "http://ticket-api:5164",
            "description": "Docker internal DNS"
        }
    ],
    "x-wso2-production-endpoints": {
        "urls": [
            "http://ticket-api:5164/api/Ticket"
        ],
        "type": "http"
    },
    "x-wso2-sandbox-endpoints": {
        "urls": [
            "http://ticket-api:5164/api/Ticket"
        ],
        "type": "http"
    },
    "x-wso2-basePath": "/ticket/v1",
    "x-wso2-auth-header": "Authorization",
    "x-wso2-disable-security": false,
    "paths": {
        "/": {
            "get": {
                "summary": "List all tickets",
                "operationId": "ticketList",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of tickets"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "x-auth-type": "None"
            },
            "post": {
                "summary": "Create a new ticket",
                "operationId": "ticketCreate",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "description",
                                    "issueType",
                                    "urgency"
                                ],
                                "properties": {
                                    "description": {
                                        "type": "string"
                                    },
                                    "issueType": {
                                        "type": "string"
                                    },
                                    "urgency": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Ticket created"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/mine": {
            "get": {
                "summary": "Get tickets for the authenticated user",
                "operationId": "ticketMine",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User's tickets"
                    },
                    "401": {
                        "description": "Unauthorized – JWT required"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/report": {
            "get": {
                "summary": "Get dynamic ticket report (admin)",
                "operationId": "ticketReport",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "urgency",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "startDate",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "endDate",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report generated"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/{id}": {
            "get": {
                "summary": "Get ticket by ID",
                "operationId": "ticketGetById",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ticket details"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/{id}/status": {
            "patch": {
                "summary": "Update ticket status",
                "operationId": "ticketUpdateStatus",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "newStatus"
                                ],
                                "properties": {
                                    "newStatus": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status updated"
                    },
                    "400": {
                        "description": "Invalid status"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/{id}/status-history": {
            "get": {
                "summary": "Get ticket status history",
                "operationId": "ticketStatusHistory",
                "tags": [
                    "Tickets"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status history returned"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/health": {
            "get": {
                "summary": "Health check",
                "operationId": "ticketHealth",
                "tags": [
                    "Diagnostics"
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "Healthy"
                    }
                },
                "x-auth-type": "None"
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
