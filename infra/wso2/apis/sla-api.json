{
    "openapi": "3.0.3",
    "info": {
        "title": "SLA API",
        "description": "Service Level Agreement monitoring and breach detection for IT Helpdesk Platform",
        "version": "1.0.0",
        "contact": {
            "name": "IT Helpdesk Team"
        }
    },
    "servers": [
        {
            "url": "http://localhost:5262",
            "description": "Local development"
        },
        {
            "url": "http://sla-api:5262",
            "description": "Docker internal DNS"
        }
    ],
    "x-wso2-production-endpoints": {
        "urls": [
            "http://sla-api:5262"
        ],
        "type": "http"
    },
    "x-wso2-sandbox-endpoints": {
        "urls": [
            "http://sla-api:5262"
        ],
        "type": "http"
    },
    "x-wso2-basePath": "/sla/v1",
    "x-wso2-auth-header": "Authorization",
    "x-wso2-disable-security": false,
    "paths": {
        "/health": {
            "get": {
                "summary": "Health check",
                "operationId": "slaHealth",
                "tags": [
                    "Diagnostics"
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "Healthy"
                    }
                }
            }
        },
        "/api/Sla/admin/tiers": {
            "get": {
                "summary": "List SLA tier durations",
                "operationId": "slaListTiers",
                "tags": [
                    "SLA Admin"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SLA tier policies"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden (Administrator only)"
                    }
                }
            }
        },
        "/api/Sla/admin/tiers/{tierName}": {
            "put": {
                "summary": "Update an SLA tier duration",
                "operationId": "slaUpdateTier",
                "tags": [
                    "SLA Admin"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "tierName",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "durationMinutes"
                                ],
                                "properties": {
                                    "durationMinutes": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 43200
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tier updated"
                    },
                    "400": {
                        "description": "Invalid duration"
                    },
                    "404": {
                        "description": "Tier not found"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden (Administrator only)"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
