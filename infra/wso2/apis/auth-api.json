{
    "openapi": "3.0.3",
    "info": {
        "title": "Auth API",
        "description": "Authentication and user management service for IT Helpdesk Platform",
        "version": "1.0.0",
        "contact": {
            "name": "IT Helpdesk Team"
        }
    },
    "servers": [
        {
            "url": "http://localhost:5121",
            "description": "Local development"
        },
        {
            "url": "http://auth-api:5121",
            "description": "Docker internal DNS"
        }
    ],
    "x-wso2-production-endpoints": {
        "urls": [
            "http://auth-api:5121/api/Auth"
        ],
        "type": "http"
    },
    "x-wso2-sandbox-endpoints": {
        "urls": [
            "http://auth-api:5121/api/Auth"
        ],
        "type": "http"
    },
    "x-wso2-basePath": "/auth/v1",
    "x-wso2-auth-header": "Authorization",
    "x-wso2-disable-security": false,
    "paths": {
        "/login": {
            "post": {
                "summary": "Login and obtain JWT",
                "operationId": "authLogin",
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "email": "user@example.com",
                                "password": "secret123"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "JWT token returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "expiresAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid credentials"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/register": {
            "post": {
                "summary": "Register a new user",
                "operationId": "authRegister",
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password",
                                    "name",
                                    "phone"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "pattern": "^\\+?[0-9]{7,15}$"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "409": {
                        "description": "Email already registered"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/forgot-password": {
            "post": {
                "summary": "Request password reset link",
                "operationId": "authForgotPassword",
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset email dispatched or accepted"
                    },
                    "400": {
                        "description": "Invalid request"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/reset-password": {
            "post": {
                "summary": "Reset user password with token",
                "operationId": "authResetPassword",
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "token",
                                    "newPassword"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "token": {
                                        "type": "string"
                                    },
                                    "newPassword": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password successfully reset"
                    },
                    "400": {
                        "description": "Invalid token or password"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/me": {
            "get": {
                "summary": "Get authenticated user profile",
                "operationId": "authGetMe",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profile details returned"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/users": {
            "get": {
                "summary": "List all users (admin)",
                "operationId": "authListUsers",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User list returned"
                    },
                    "401": {
                        "description": "Unauthorized – missing or invalid JWT"
                    },
                    "403": {
                        "description": "Forbidden – insufficient role"
                    }
                },
                "x-auth-type": "None"
            },
            "post": {
                "summary": "Create user (admin)",
                "operationId": "authCreateUser",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "role",
                                    "phone"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "integer"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "pattern": "^\\+?[0-9]{7,15}$"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "409": {
                        "description": "Email already exists"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/users/{id}": {
            "get": {
                "summary": "Get one user's contact details (agent or admin)",
                "operationId": "authGetUser",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User returned"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "User not found"
                    }
                },
                "x-auth-type": "None"
            },
            "put": {
                "summary": "Update user (admin)",
                "operationId": "authUpdateUser",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "role": {
                                        "type": "integer"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "pattern": "^\\+?[0-9]{7,15}$"
                                    }
                                },
                                "required": [
                                    "name",
                                    "email",
                                    "phone",
                                    "role"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User updated"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "400": {
                        "description": "Validation error"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/users/{id}/deactivate": {
            "patch": {
                "summary": "Deactivate user (admin)",
                "operationId": "authDeactivateUser",
                "tags": [
                    "Users"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User deactivated"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "User not found"
                    }
                },
                "x-auth-type": "None"
            }
        },
        "/health": {
            "get": {
                "summary": "Health check",
                "operationId": "authHealth",
                "tags": [
                    "Diagnostics"
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "Healthy"
                    }
                },
                "x-auth-type": "None"
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
